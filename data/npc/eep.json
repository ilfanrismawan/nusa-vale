  "dialogue": {
    "default": [
      {
        "text": "Aku Eep. Kalau kamu ingin mulai beternak, kita bisa mencari hewan yang cocok untuk kebunmu.",
        "expression": "happy"
      },
      {
        "text": "Siapkan kandang, pakan, dan waktu untuk merawatnya sebelum membawa hewan pulang.",
        "expression": "neutral"
      }
    ],
    "checking_feed": [
      {
        "text": "Aku sedang memeriksa pakan dan kondisi hewan. Lapak buka pukul sembilan.",
        "expression": "happy"
      },
      {
        "text": "Ayam dan bebek tinggal di kandang unggas. Sapi, kambing, dan domba memerlukan kandang ternak.",
        "expression": "neutral"
      }
    ],
    "selling": [
      {
        "text": "Mau mencari teman baru untuk peternakanmu? Semua hewan di lapakku sudah dewasa.",
        "expression": "happy"
      },
      {
        "text": "Pilih kandang yang sesuai, beri nama, lalu aku akan mengantarkannya ke sana.",
        "expression": "neutral"
      },
      {
        "text": "Setiap Rabu lapak libur. Aku perlu waktu untuk memeriksa kesehatan hewan di ranch.",
        "expression": "neutral"
      }
    ],
    "lunch": [
      {
        "text": "Istirahat makan dulu. Merawat hewan juga perlu tenaga!",
        "expression": "happy"
      },
      {
        "text": "Hewan yang kenyang dan kandangnya bersih akan menghasilkan produk dengan kualitas lebih baik.",
        "expression": "neutral"
      }
    ],
    "resting": [
      {
        "text": "Lapak sudah tutup. Aku memeriksa catatan pesanan sebelum pulang.",
        "expression": "neutral"
      },
      {
        "text": "Jangan lupa cek pakan sebelum tidur. Saat hujan, hewan perlu makan di dalam kandang.",
        "expression": "neutral"
      }
    ],
    "sleeping": [
      {
        "text": "Aku pulang ke ranch di luar gerbang barat. Sampai besok pagi!",
        "expression": "happy"
      }
    ]
  },
  "dialogue_by_hearts": {
    "4": [
      {
        "text": "Senang melihatmu makin telaten merawat hewan. Peternakan yang nyaman dimulai dari kebiasaan kecil.",
        "expression": "happy"
      },
      {
        "text": "Terima kasih sudah mau belajar menyapa hewan dengan sabar.",
        "expression": "happy",
        "requires_flags": [
          "eep_ranch_trust"
        ]
      }
    ],
    "8": [
      {
        "text": "Kalau hewan-hewan itu betah di kebunmu, aku ikut merasa senang. Terima kasih sudah menjaga mereka.",
        "expression": "sparkle"
      }
    ]
  },
