    "family_time": [
      {
        "text": "Rumah ramai kalau Zarathia sudah pulang. Dia cerewet, tapi aku sayang.",
        "expression": "happy"
      },
      {
        "text": "Aku masih sedikit marah soal Ibu. Tapi sekarang aku mengerti kenapa Ayah selalu diam.",
