    "hanging_out": [
      {
        "text": "Habis kerja memang paling enak jalan-jalan sebentar di kota.",
        "expression": "happy"
      },
      {
        "text": "Kamu sering lewat sini? Kita bisa ngobrol kapan-kapan.",
        "expression": "neutral"
      }
