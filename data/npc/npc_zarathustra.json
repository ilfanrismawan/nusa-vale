  "dialogue": {
    "default": [
      {
        "text": "Oh, hai! Aku lagi belajar bikin sambungan kayu yang rapi seperti punya Ayah.",
        "expression": "happy"
      }
    ],
    "breakfast": [
      {
        "text": "Ayah bikin teh lagi. Aku kebagian yang pahit, hehe.",
        "expression": "happy"
      },
      {
        "text": "Hari ini aku janji tidak menjatuhkan papan lagi.",
        "expression": "neutral"
      }
    ],
    "carrying_wood": [
      {
        "text": "Awas, awas! Kayunya panjang, jangan sampai kena kepalamu.",
        "expression": "sparkle"
      }
    ],
    "apprenticing": [
      {
        "text": "Ayah bilang ukur dua kali, potong sekali. Aku baru sampai tahap ukur yang pertama.",
        "expression": "neutral"
      },
      {
        "text": "Suatu hari aku mau punya bengkel sendiri, tapi masih panjang jalannya.",
        "expression": "sparkle"
      },
      {
        "text": "Aku mau punya bengkel sendiri supaya keluargaku nanti tidak pernah kekurangan.",
