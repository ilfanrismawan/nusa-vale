		  "expression": "neutral"
		},
		{
		  "text": "Anakku pernah tanya kenapa aku membiarkan ibunya pergi. Aku belum tahu cara menjawab tanpa membuat dia merasa harus membela salah satu dari kami.",
		  "expression": "annoyed"
		},
		{
		  "text": "Terima kasih sudah mau mendengarkan.",
		  "expression": "happy"
