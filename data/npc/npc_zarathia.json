  "dialogue": {
    "default": [
      {
        "text": "Mau mampir minum teh? Hari ini aku buat yang agak manis.",
        "expression": "happy"
      }
    ],
    "breakfast": [
      {
        "text": "Aku bangun lebih awal supaya sempat menyeduh teh untuk Ayah dan Thustra.",
        "expression": "happy"
      },
      {
        "text": "Zarathustra makannya cepat sekali. Aku selalu harus menyisakan bagian untukku.",
        "expression": "neutral"
      }
    ],
    "tea_stall": [
      {
        "text": "Selamat datang. Teh hangat, kue pisang, atau dua-duanya?",
        "expression": "sparkle"
      },
      {
        "text": "Warung kecil ini mungkin sepi, tapi aku suka melihat orang berhenti sebentar untuk minum.",
        "expression": "neutral"
      },
      {
        "text": "Warung teh ini kecil, tapi aku ingin rumah kami selalu punya sesuatu yang hangat.",
        "expression": "happy",
        "requires_flags": [
          "story_zarathia_told"
        ]
      }
    ],
    "lunch": [
      {
        "text": "Makan siang di bangku ini dengan pemandangan kota. Tidak buruk.",
        "expression": "happy"
      }
    ],
    "sketching": [
      {
        "text": "Aku sedang menggambar atap-atap desa. Jangan lihat dulu, belum rapi.",
        "expression": "annoyed"
      },
      {
        "text": "Dari bukit ini, semuanya terlihat lebih tenang.",
        "expression": "happy"
      }
    ],
    "baking": [
      {
        "text": "Kalau hujan, aku panggang kue di rumah. Baunya enak, kan?",
        "expression": "sparkle"
      }
    ],
    "family_time": [
      {
        "text": "Kami bertiga kadang diam saja sambil minum teh. Tapi rasanya hangat.",
        "expression": "happy"
      },
      {
        "text": "Kursi di ujung meja itu dulu tempat Ibu. Sekarang tidak ada yang mau duduk di sana.",
        "expression": "neutral",
        "requires_flags": [
          "story_zarathia_told"
        ]
      },
      {
        "text": "Surat Ibu sudah kami baca bertiga. Rasanya kursi itu tidak sedingin dulu lagi.",
        "expression": "happy",
        "requires_flags": [
          "family_truth_known"
        ]
      }
    ],
    "sleeping": [
      {
        "text": "Sudah malam. Sampai ketemu besok.",
        "expression": "neutral"
      }
    ]
  },
  "dialogue_by_hearts": {
