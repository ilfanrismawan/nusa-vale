[gd_resource type="Resource" script_class="ActionData" format=3]

[ext_resource type="Script" path="res://scripts/effects/fishing_effect.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/state/action_data.gd" id="2_ad"]
[ext_resource type="Texture2D" path="res://resources/icons/icon_fishing_rod_frost.tres" id="3_icon"]
[ext_resource type="Resource" path="res://resources/tool_data/fishing_rod_frost.tres" id="4_td"]

[sub_resource type="Resource" id="eff_sub"]
script = ExtResource("1_eff")

[resource]
script = ExtResource("2_ad")
