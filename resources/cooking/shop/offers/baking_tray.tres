[ext_resource type="Resource" path="res://resources/cooking/equipment/baking_tray.tres" id="equipment"]
[resource]
script = ExtResource("script")
id = &"baking_tray"
display_name = "Loyang"
description = "Loyang dipasang permanen di dapur rumah dan tersedia untuk semua penghuni. Alat tidak habis saat memasak. Membutuhkan renovasi ruang dapur rumah."
