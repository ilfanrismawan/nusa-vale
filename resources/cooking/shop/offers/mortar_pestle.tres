description = "Cobek dan Ulekan dipasang permanen di dapur rumah dan tersedia untuk semua penghuni. Alat tidak habis saat memasak. Membutuhkan renovasi ruang dapur rumah."
price = 1000
required_flags = PackedStringArray("house_kitchen_upgraded")
