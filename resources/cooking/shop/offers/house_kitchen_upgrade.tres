[ext_resource type="Texture2D" path="res://resources/cooking/shop/art/WoodKitchenDisplay.tres" id="icon"]
[resource]
script = ExtResource("script")
id = &"house_kitchen_upgrade"
display_name = "Upgrade Rumah · Ruang Dapur"
description = "Renovasi rumah untuk membuka ruangan dapur tambahan. Setelah selesai, akses ruang dapur melalui pintu dapur di rumah. Wajib sebelum membeli peralatan masak atau kitchen set. Harga dan bahan renovasi dapat diubah di resource ini."
icon = ExtResource("icon")
price = 5000
owned_flag = "house_kitchen_upgraded"
purchase_message = "Renovasi rumah selesai. Pintu Dapur di rumah sudah terbuka; peralatan dan kitchen set sekarang dapat dibeli."
