[ext_resource type="Resource" path="res://resources/cooking/equipment/rice_cooker.tres" id="equipment"]
[resource]
script = ExtResource("script")
id = &"rice_cooker"
display_name = "Penanak Nasi"
description = "Penanak Nasi dipasang permanen di dapur rumah dan tersedia untuk semua penghuni. Alat tidak habis saat memasak. Membutuhkan renovasi ruang dapur rumah."
