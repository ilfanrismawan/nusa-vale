[gd_resource type="Resource" script_class="CraftingCatalog" format=3]

[ext_resource type="Script" path="res://scripts/resources/crafting_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/resources/witch_recipe.gd" id="2_recipe"]

[sub_resource type="Resource" id="Recipe_brew_elixir_vigor"]
