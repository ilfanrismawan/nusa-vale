"bunga_kantil": 3,
"moon_dew": 1,
"stardust": 1
}
group = "Jimat"
minigame = "rune"
note = "Rune Pengikat (spiral)."
difficulty = 1
rune = "charm"

[sub_resource type="Resource" id="Recipe_charm_jimat_rembulan"]
