[resource]
script = ExtResource("1_catalog")
recipes = Array[ExtResource("2_recipe")]([SubResource("Recipe_charm_jimat_kantil"), SubResource("Recipe_charm_jimat_rembulan"), SubResource("Recipe_charm_jimat_bintang")])
