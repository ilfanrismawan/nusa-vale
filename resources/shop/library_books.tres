[resource]
script = ExtResource("1_shop")
shop_id = "library_books"
shop_name = "Perpustakaan"
keeper_name = "Pustakawan"
greeting = "Buku riset bisa mempercepat keahlianmu. Satu buku, satu bidang."
stock = Array[ExtResource("2_item")]([ExtResource("farmer"), ExtResource("forager"), ExtResource("fisher"), ExtResource("combat"), ExtResource("miner"), ExtResource("merchant"), ExtResource("economist")])
buys_items = false
