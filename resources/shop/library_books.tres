[gd_resource type="Resource" script_class="ShopData" format=3]

[ext_resource type="Script" path="res://scripts/resources/shop_data.gd" id="1_shop"]
[ext_resource type="Script" path="res://scripts/data/item_data.gd" id="2_item"]
[ext_resource type="Resource" path="res://resources/item_data/skill_book_farmer.tres" id="farmer"]
[ext_resource type="Resource" path="res://resources/item_data/skill_book_forager.tres" id="forager"]
[ext_resource type="Resource" path="res://resources/item_data/skill_book_fisher.tres" id="fisher"]
