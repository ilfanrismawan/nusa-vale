[resource]
script = ExtResource("1_shop")
shop_id = "magic_shop"
shop_name = "Toko Sihir"
keeper_name = "Nyai Kenanga"
greeting = "Tongkat untuk tiap tingkat, bahan sihir untuk kuali. Pilih dengan hati, murid muda."
buys_items = true
stock = Array[ExtResource("2_item")]([ExtResource("staff_wood"), ExtResource("staff_copper"), ExtResource("staff_iron"), ExtResource("staff_gold"), ExtResource("staff_platinum"), ExtResource("staff_crimson"), ExtResource("staff_frost"), ExtResource("staff_shadow"), ExtResource("staff_fairy"), ExtResource("staff_obsidian"), ExtResource("stardust"), ExtResource("moon_dew")])
