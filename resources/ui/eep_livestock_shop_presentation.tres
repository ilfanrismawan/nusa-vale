[gd_resource type="Resource" format=3]

[ext_resource type="Texture2D" path="res://assets/farm_rpg/icons/Farm Animals/Animals farm icons.png" id="animal_icons"]
[ext_resource type="Texture2D" path="res://assets/farm_rpg/Character/NPC'S/Eep/npc_portrait_eep.png" id="portrait"]
[ext_resource type="Script" path="res://scripts/resources/livestock_shop_presentation.gd" id="script"]

[sub_resource type="AtlasTexture" id="Chicken"]
atlas = ExtResource("animal_icons")
region = Rect2(64, 64, 16, 16)
filter_clip = true

[sub_resource type="AtlasTexture" id="BrownChicken"]
atlas = ExtResource("animal_icons")
region = Rect2(64, 48, 16, 16)
filter_clip = true

[sub_resource type="AtlasTexture" id="Cow"]
atlas = ExtResource("animal_icons")
