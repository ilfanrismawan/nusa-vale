[node name="RianNPC" type="CharacterBody2D"]
y_sort_enabled = true
collision_layer = 1
collision_mask = 1
script = ExtResource("1_npc")
npc_id = "rian"
npc_name = "Rian"
role_title = "Penjual Ternak"
portrait = ExtResource("4_portrait")
walk_speed = 36.0
dialog_lines = PackedStringArray("Mulai dengan kandang dari Pak Damar. Unggas memberi telur; sapi, kambing, dan domba memberi susu atau wol.", "Setiap pagi: panen, beri pakan, elus, sikat ternak besar, lalu bersihkan kandang. Peralatan tersedia di toko.")
schedule = [{
"activity": "Memberi makan hewan ternak di padang rumput",
"dialog_lines": PackedStringArray("Satu hewan perlu satu pakan per hari. Buka pintu saat cerah agar mereka mencari rumput pakan dekat kandang.", "Jaga kandang bersih. Hewan yang kurang sehat pulih setelah sehari penuh makan di kandang bersih. Telaten merawat meningkatkan kualitas hasil!"),
"facing": "down",
"hour": 6,
"minute": 0,
"path": [],
"target_pos": Vector2(450, 490)
}, {
"activity": "Berjalan makan siang ke Warung Makan Pak Joko",
"dialog_lines": PackedStringArray("Waktunya istirahat siang! Soto ayam hangat buatan Pak Joko adalah menu favoritku."),
"facing": "side_right",
"hour": 11,
"minute": 30,
"path": [Vector2(520, 450), Vector2(740, 430), Vector2(880, 420)],
"target_pos": Vector2(880, 420)
}, {
"activity": "Duduk santai di taman dekat air mancur",
"dialog_lines": PackedStringArray("Suara gemercik air mancur di alun-alun ini sangat menenangkan.", "Kadang-kadang burung-burung liar hinggap di dekat sini mencari biji-bijian."),
"facing": "side_left",
"hour": 14,
"minute": 0,
"path": [Vector2(740, 430), Vector2(560, 430)],
"target_pos": Vector2(560, 430)
}, {
"activity": "Pulang ke rumah barat",
"dialog_lines": PackedStringArray("Hewan kembali ke kandang pukul enam sore. Periksa cadangan jerami sebelum tidur; saat hujan mereka perlu pakan di dalam."),
"facing": "down",
"hour": 18,
"minute": 30,
"path": [Vector2(500, 460), Vector2(450, 490)],
"target_pos": Vector2(450, 490)
}]

