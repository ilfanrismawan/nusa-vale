script = ExtResource("1_village_npc")
npc_id = "wira"
npc_name = "Wira"
role_title = "Penjelajah Rimba"
portrait = ExtResource("3_tori_portrait")
walk_speed = 40.0
dialog_lines = PackedStringArray("Hai! Aku Wira, penjelajah rimba Nusa Vale. Hari yang cerah untuk bertualang, bukan?", "Hutan belantara di barat menyimpan kayu jati kokoh dan aneka tanaman liar berkhasiat.", "Selalu perhatikan energimu saat menebang pohon dan menambang batu agar tidak tumbang sebelum petang!")
schedule = [{
"activity": "Patroli pagi di alun-alun kota",
"dialog_lines": PackedStringArray("Selamat pagi! Udara alun-alun pagi ini sangat segar.", "Aku sedang bersiap untuk mengecek jalur setapak menuju perbukitan."),
"facing": "down",
"hour": 6,
"minute": 0,
"path": [],
"target_pos": Vector2(748, 436)
}, {
"activity": "Memantau jalan masuk hutan",
"dialog_lines": PackedStringArray("Pintu masuk hutan terlihat tenang hari ini.", "Pastikan kapak dan beliungmu dalam kondisi tajam jika ingin mencari kayu keras ke dalam sana!"),
"facing": "side_left",
"hour": 10,
"minute": 0,
"path": [Vector2(650, 436), Vector2(520, 420), Vector2(460, 420)],
"target_pos": Vector2(460, 420)
}, {
"activity": "Makan siang di warung makan",
"dialog_lines": PackedStringArray("Menjelajah hutan menguras banyak tenaga. Waktunya mengisi perut di Warung Pak Joko!"),
"facing": "side_right",
"hour": 13,
"minute": 0,
"path": [Vector2(520, 420), Vector2(740, 436), Vector2(890, 420)],
"target_pos": Vector2(890, 420)
}, {
"activity": "Duduk di dekat taman air mancur",
"dialog_lines": PackedStringArray("Matahari sore terasa hangat di sini.", "Kudengar festival balap karung dan lomba lari akan diadakan sebentar lagi. Aku giat berlatih setiap hari!"),
"facing": "side_left",
"hour": 16,
"minute": 30,
"path": [Vector2(740, 436), Vector2(550, 420)],
"target_pos": Vector2(550, 420)
}, {
"activity": "Kembali ke alun-alun kota",
"dialog_lines": PackedStringArray("Malam mulai larut. Saatnya pulang dan beristirahat."),
"facing": "down",
"hour": 20,
"minute": 0,
"path": [Vector2(650, 436), Vector2(748, 436)],
"target_pos": Vector2(748, 436)
}]

