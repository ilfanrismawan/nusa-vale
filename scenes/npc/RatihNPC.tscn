walk_speed = 34.0
dialog_lines = PackedStringArray("Halo! Jangan paksakan bekerja di ladang sampai kehabisan tenaga.", "Tanaman herbal liar yang tumbuh di sekitar hutan bisa diolah menjadi ramuan penambah stamina alami.")
schedule = [{
"activity": "Membuka Klinik Desa",
"dialog_lines": PackedStringArray("Selamat pagi. Apotek klinik sudah buka.", "Jika tubuhmu terasa lelah atau terluka karena menjelajah tambang, segera periksakan ke mari ya."),
"facing": "down",
"hour": 7,
"minute": 0,
"path": [],
"target_pos": Vector2(519, 340)
}, {
"activity": "Menghirup udara segar di taman bunga",
"dialog_lines": PackedStringArray("Bunga-bunga di sekitar air mancur ini bermekaran sangat indah hari ini.", "Udara segar di luar ruangan adalah obat terbaik untuk menjernihkan pikiran."),
"facing": "side_left",
"hour": 12,
"minute": 30,
"path": [Vector2(519, 380), Vector2(510, 415)],
"target_pos": Vector2(510, 415)
}, {
"activity": "Meracik obat herbal di klinik",
"dialog_lines": PackedStringArray("Aku sedang menumbuk daun pegagan dan jahe merah untuk membuat salep pemulih memar."),
"facing": "down",
"hour": 14,
"minute": 30,
"path": [Vector2(519, 380), Vector2(519, 340)],
"target_pos": Vector2(519, 340)
}, {
"activity": "Istirahat malam di klinik",
"dialog_lines": PackedStringArray("Klinik sudah tutup untuk hari ini. Pastikan kamu tidur cukup malam ini agar esok bangun dengan bugar!"),
"facing": "side_right",
"hour": 18,
"minute": 30,
"path": [Vector2(535, 335)],
"target_pos": Vector2(535, 335)
}]

