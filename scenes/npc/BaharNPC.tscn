script = ExtResource("1_npc")
npc_id = "bahar"
npc_name = "Pak Bahar"
role_title = "Nelayan Sepuh"
portrait = ExtResource("4_portrait")
walk_speed = 32.0
dialog_lines = PackedStringArray("Ah, anak muda! Laut dan sungai di Nusa Vale ini penuh misteri.", "Setiap jenis ikan punya waktu favoritnya sendiri. Ada yang hanya keluar saat hujan lebat, dan ada yang baru berenang ke permukaan saat malam purnama.")
schedule = [{
"activity": "Memancing di dermaga jembatan selatan",
"dialog_lines": PackedStringArray("Angin fajar bertiup kencang dari arah timur. Ini pertanda baik untuk memancing ikan kakap!", "Gunakan umpan yang tepat dan perhatikan getaran pelampung pancingmu."),
"facing": "down",
"hour": 5,
"minute": 0,
"path": [],
"target_pos": Vector2(680, 770)
}, {
"activity": "Berjalan ke alun-alun kota",
"dialog_lines": PackedStringArray("Kaki tuaku butuh sedikit peregangan. Senang melihat suasana alun-alun yang selalu ramai."),
"facing": "side_right",
"hour": 12,
"minute": 0,
"path": [Vector2(680, 600), Vector2(560, 450), Vector2(520, 430)],
"target_pos": Vector2(520, 430)
}, {
"activity": "Memeriksa jala dan perahu di dermaga",
"dialog_lines": PackedStringArray("Air laut mulai pasang. Waktunya menambatkan perahu dengan kokoh agar tidak terbawa arus malam."),
"facing": "up",
"hour": 16,
"minute": 0,
"path": [Vector2(560, 450), Vector2(680, 600), Vector2(680, 770)],
"target_pos": Vector2(680, 770)
}, {
"activity": "Menikmati teh jahe di Warung Makan",
"dialog_lines": PackedStringArray("Secangkir wedang jahe buatan Pak Joko sangat mujarab menghangatkan tulang sepuhku dari dinginnya angin laut."),
"facing": "down",
"hour": 19,
"minute": 30,
"path": [Vector2(680, 600), Vector2(800, 440), Vector2(870, 410)],
"target_pos": Vector2(870, 410)
}]

