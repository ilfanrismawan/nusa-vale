[node name="ChefNPC" type="CharacterBody2D"]
y_sort_enabled = true
collision_layer = 1
collision_mask = 1
script = ExtResource("1_village_npc")
npc_id = "joko"
npc_name = "Pak Joko"
role_title = "Koki Warung Nusa"
portrait = ExtResource("3_chef_portrait")
walk_speed = 36.0
dialog_lines = PackedStringArray("Halo kawan! Selamat datang di Warung Rasa Nusa.", "Aroma racikan rempah seperti serai, kunyit, dan daun salam selalu segar setiap pagi di dapurku.", "Hasil panen sayur dan ikan segar dari kebunmu adalah bahan terbaik untuk santapan lezat pemulih tenaga!")
schedule = [{
"activity": "Menyiapkan bumbu di dapur warung",
"dialog_lines": PackedStringArray("Panci besar sudah kupanaskan. Hari ini aku akan merebus kaldu iga rempah."),
"facing": "down",
"hour": 6,
"minute": 0,
"path": [],
"target_pos": Vector2(895, 388)
}, {
"activity": "Melayani santap siang di etalase warung",
"dialog_lines": PackedStringArray("Selamat siang! Mau pesan nasi liwet atau pindang patin hangat hari ini?"),
"facing": "side_left",
"hour": 11,
"minute": 30,
"path": [Vector2(750, 380), Vector2(650, 360)],
"target_pos": Vector2(650, 360)
}, {
"activity": "Kembali memasak di dapur warung",
"dialog_lines": PackedStringArray("Waktu makan siang selesai, sekarang aku meracik adonan kue serabi untuk cemilan sore."),
"facing": "down",
"hour": 14,
"minute": 30,
"path": [Vector2(750, 380), Vector2(895, 388)],
"target_pos": Vector2(895, 388)
}, {
"activity": "Menghidangkan santap malam di meja warung",
"dialog_lines": PackedStringArray("Malam yang dingin paling nikmat ditemani semangkuk wedang ronde hangat."),
"facing": "side_right",
"hour": 18,
"minute": 0,
"path": [Vector2(895, 400), Vector2(870, 410)],
"target_pos": Vector2(870, 410)
}, {
"activity": "Membereskan dapur warung",
"dialog_lines": PackedStringArray("Dapur sudah kubersihkan. Istirahatlah yang cukup, esok hari kita mulai lagi dengan semangat baru!"),
"facing": "down",
"hour": 21,
"minute": 0,
"path": [Vector2(895, 388)],
"target_pos": Vector2(895, 388)
}]

