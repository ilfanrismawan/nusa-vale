portrait = ExtResource("3_chef_portrait")
dialog_lines = PackedStringArray("Halo kawan! Selamat datang di Warung Rasa Nusa.", "Aroma racikan rempah seperti serai, kunyit, dan daun salam selalu segar setiap pagi di dapurku.", "Hasil panen sayur dan ikan segar dari kebunmu adalah bahan terbaik untuk santapan lezat pemulih tenaga!", "Saat festival desa tiba nanti, singgahlah ke mari. Aku akan memasak tumpeng dan rawon istimewa untuk seluruh warga pulau!")

