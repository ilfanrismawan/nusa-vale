[node name="UbayNPC" type="CharacterBody2D"]
y_sort_enabled = true
collision_layer = 1
collision_mask = 1
script = ExtResource("1_npc")
npc_id = "ubay"
npc_name = "Ubay"
role_title = "Pemuda Nusa Vale"
portrait = ExtResource("4_portrait")
walk_speed = 38.0
dialog_lines = PackedStringArray("Halo bro! Gimana kabarmu hari ini di Nusa Vale?", "Aku suka banget nongkrong di alun-alun sambil dengerin suara air mancur. Hawanya sejuk dan bikin pikiran adem!", "Kalo kamu butuh bantuan atau mau ngobrol santai, cari aja aku di sekitar taman atau warung makan ya!")
schedule = [{
"activity": "Jalan santai pagi di alun-alun kota",
"dialog_lines": PackedStringArray("Selamat pagi bro! Matahari baru terbit dan hawanya bener-bener segar.", "Hari ini rencanamu mau berkebun atau menjelajah ke hutan barat?"),
"facing": "down",
"hour": 6,
"minute": 30,
"path": [],
"target_pos": Vector2(620, 430)
}, {
"activity": "Makan siang di Warung Makan Pak Joko",
"dialog_lines": PackedStringArray("Waktunya makan siang nih! Masakan Pak Joko emang gak pernah gagal bikin kenyang."),
"facing": "side_right",
"hour": 11,
"minute": 30,
"path": [Vector2(750, 430), Vector2(880, 430)],
"target_pos": Vector2(880, 430)
}, {
"activity": "Duduk santai di bangku taman dekat air mancur",
"dialog_lines": PackedStringArray("Nongkrong di sini pas sore emang paling pas buat ngilangin penat.", "Kudengar festival balap karung bakal diadain sebentar lagi. Pokoknya kita harus ikutan!"),
"facing": "side_left",
"hour": 14,
"minute": 0,
"path": [Vector2(750, 430), Vector2(550, 440)],
"target_pos": Vector2(550, 440)
}, {
"activity": "Jalan-jalan sore ke tepi jembatan selatan",
"dialog_lines": PackedStringArray("Matahari terbenam di ufuk barat indah banget ya kalau dilihat dari dekat jembatan."),
"facing": "down",
"hour": 18,
"minute": 30,
"path": [Vector2(550, 500), Vector2(650, 700)],
"target_pos": Vector2(650, 700)
}, {
"activity": "Pulang ke rumah di dekat alun-alun",
"dialog_lines": PackedStringArray("Udah malam nih, bro. Jangan lupa istirahat yang cukup biar besok bugar lagi!"),
"facing": "up",
"hour": 21,
"minute": 0,
"path": [Vector2(650, 500), Vector2(620, 430)],
"target_pos": Vector2(620, 430)
}]

